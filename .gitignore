# macOS
.DS_Store
._*

# Dropbox
.dropbox
*.sb-*

# Editor
.vscode/settings.json
*.swp

# Python
__pycache__/
*.pyc

# Original camera files stay on your computer only — they are far too large
# for the website (some are 15 MB each). Run scripts/optimize_images.py to
# create the small web/ copies, and only those get published.
images/*/*
!images/*/README.txt
!images/*/web/
!images/*/web/**
# Officer headshots are already resized and live directly in this folder,
# so they need their own exception to the rule above.
!images/officers/
!images/officers/*.jpg

# Source document for the officer bios. Kept locally, not published.
*.docx

# Source photo for the hero, resized copy lives in images/hero-ds.jpg
ds group photo.jpg
